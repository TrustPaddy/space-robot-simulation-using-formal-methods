\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Overview of the Robot Subsystem in the Simulink Model \texttt  {SpaceRobot.slx}   This figure depicts the Simulink/Simscape Multibody model of the free-floating space robot, consisting of a floating base and a serial 4-DOF manipulator. Joint torque commands are applied to the revolute joints, while joint positions and velocities are measured and fed back as state variables. The base orientation is represented as a normalized quaternion and compared to a reference to compute the base attitude error.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:spacerobot_slx_robot}{{3}{5}{Overview of the Robot Subsystem in the Simulink Model \texttt {SpaceRobot.slx} \\ This figure depicts the Simulink/Simscape Multibody model of the free-floating space robot, consisting of a floating base and a serial 4-DOF manipulator. Joint torque commands are applied to the revolute joints, while joint positions and velocities are measured and fed back as state variables. The base orientation is represented as a normalized quaternion and compared to a reference to compute the base attitude error}{figure.caption.4}{}}
\newlabel{fig:spacerobot_slx_robot@cref}{{[figure][3][]3}{[1][4][]5}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {II-D}}Reference Trajectory and Desired Task}{5}{subsection.2.4}\protected@file@percent }
