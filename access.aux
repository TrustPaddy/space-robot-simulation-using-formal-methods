\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Overview of the Collision Monitor Subsystem in the Simulink Model \texttt  {SpaceRobot.slx}   This figure illustrates the collision monitoring logic used to ensure safe robot operation during training and evaluation. Joint and link configurations are processed to compute the minimum distance to obstacles, which is compared against a predefined safety threshold. A collision flag is generated and used for episode termination or safety-related penalties.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:spacerobot_slx_colissionmonitor}{{7}{12}{Overview of the Collision Monitor Subsystem in the Simulink Model \texttt {SpaceRobot.slx} \\ This figure illustrates the collision monitoring logic used to ensure safe robot operation during training and evaluation. Joint and link configurations are processed to compute the minimum distance to obstacles, which is compared against a predefined safety threshold. A collision flag is generated and used for episode termination or safety-related penalties}{figure.caption.9}{}}
\newlabel{fig:spacerobot_slx_colissionmonitor@cref}{{[figure][7][]7}{[1][10][]12}{}{}{}}
