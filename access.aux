\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Result of the Simulink Design Verifier   This figure shows the result of a formal property verification performed on the torque constraint model. The verification confirms that the specified safety property is satisfied for all analyzed execution paths. This analysis provides model-based evidence for torque-limit compliance beyond empirical simulation-based validation.}}{13}{figure.caption.14}\protected@file@percent }
\newlabel{fig:verify_tau_result}{{11}{13}{Result of the Simulink Design Verifier \\ This figure shows the result of a formal property verification performed on the torque constraint model. The verification confirms that the specified safety property is satisfied for all analyzed execution paths. This analysis provides model-based evidence for torque-limit compliance beyond empirical simulation-based validation}{figure.caption.14}{}}
\newlabel{fig:verify_tau_result@cref}{{[figure][11][]11}{[1][13][]13}{}{}{}}
