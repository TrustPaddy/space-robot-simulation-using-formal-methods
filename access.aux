\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Selected performance metrics for each RL agent (best value in each row in bold). PPO attains the lowest tracking errors (K2, K3), the lowest base-orientation error (K4), and the lowest jerk (K7), with the shortest training time (T3). TRPO is close to PPO on several metrics but requires more training time. The off-policy methods (TD3, SAC, DDPG) show larger errors or a larger late-training reward variance (e.g., high T1 for DDPG); DDPG attains the lowest maximum error (K3). Values are averaged over 30 evaluation episodes per agent.}}{15}{table.caption.16}\protected@file@percent }
\newlabel{tab:kpi_comp}{{5}{15}{Selected performance metrics for each RL agent (best value in each row in bold). PPO attains the lowest tracking errors (K2, K3), the lowest base-orientation error (K4), and the lowest jerk (K7), with the shortest training time (T3). TRPO is close to PPO on several metrics but requires more training time. The off-policy methods (TD3, SAC, DDPG) show larger errors or a larger late-training reward variance (e.g., high T1 for DDPG); DDPG attains the lowest maximum error (K3). Values are averaged over 30 evaluation episodes per agent}{table.caption.16}{}}
\newlabel{tab:kpi_comp@cref}{{[table][5][]5}{[1][14][]15}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Pairwise Wilcoxon signed-rank tests: each agent vs.\ PPO (baseline), Holm-corrected. Each cell shows $\Delta \tilde  {x}$ (median difference, agent$-$PPO) with significance superscript: ${}^{***}p<0.001$, ${}^{**}p<0.01$, ${}^{*}p<0.05$, ${}^{\mathrm  {n.s.}}p\geq 0.05$. For K1, positive $\Delta \tilde  {x}$ means the agent achieves a higher (better) return. For K2--K9, negative $\Delta \tilde  {x}$ means lower (better) error/violation/jerk/energy values. K5 is the collision rate (0\,=\,no collisions); all evaluated agents achieved K5\,=\,0.}}{15}{table.caption.17}\protected@file@percent }
\newlabel{tab:significance}{{6}{15}{Pairwise Wilcoxon signed-rank tests: each agent vs.\ PPO (baseline), Holm-corrected. Each cell shows $\Delta \tilde {x}$ (median difference, agent$-$PPO) with significance superscript: ${}^{***}p<0.001$, ${}^{**}p<0.01$, ${}^{*}p<0.05$, ${}^{\mathrm {n.s.}}p\geq 0.05$. For K1, positive $\Delta \tilde {x}$ means the agent achieves a higher (better) return. For K2--K9, negative $\Delta \tilde {x}$ means lower (better) error/violation/jerk/energy values. K5 is the collision rate (0\,=\,no collisions); all evaluated agents achieved K5\,=\,0}{table.caption.17}{}}
\newlabel{tab:significance@cref}{{[table][6][]6}{[1][14][]15}{}{}{}}
