\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Overview of the Impuls Monitor Subsystem (Momentum Observer) in the Simulink Model \texttt  {SpaceRobot.slx}   This figure shows the computation of the total linear and angular momentum of the free-floating space robot. The velocities and orientations of the base and all manipulator links are measured and aggregated within a MATLAB function to obtain the system momentum. This monitor is used to analyze momentum conservation and quantify base–manipulator dynamic coupling effects.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:impuls_monitor}{{6}{10}{Overview of the Impuls Monitor Subsystem (Momentum Observer) in the Simulink Model \texttt {SpaceRobot.slx} \\ This figure shows the computation of the total linear and angular momentum of the free-floating space robot. The velocities and orientations of the base and all manipulator links are measured and aggregated within a MATLAB function to obtain the system momentum. This monitor is used to analyze momentum conservation and quantify base–manipulator dynamic coupling effects}{figure.caption.7}{}}
\newlabel{fig:impuls_monitor@cref}{{[figure][6][]6}{[1][9][]10}{}{}{}}
