\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Verification model with Simulink Design Verifier \texttt  {Verify\_tau.slx}   This figure depicts the Simulink property model used to formally verify the joint torque constraints. The absolute joint torques are compared against predefined maximum limits using a relational operator. The property is proven to hold for all reachable system states, ensuring bounded control actions.}}{13}{figure.caption.11}\protected@file@percent }
\newlabel{fig:verify_tau}{{9}{13}{Verification model with Simulink Design Verifier \texttt {Verify\_tau.slx} \\ This figure depicts the Simulink property model used to formally verify the joint torque constraints. The absolute joint torques are compared against predefined maximum limits using a relational operator. The property is proven to hold for all reachable system states, ensuring bounded control actions}{figure.caption.11}{}}
\newlabel{fig:verify_tau@cref}{{[figure][9][]9}{[1][11][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Result of the Simulink Design Verifier   This figure shows the result of a formal property verification performed on the torque constraint model. The verification confirms that the specified safety property is satisfied for all analyzed execution paths. This analysis provides formal guarantees on control torque limits beyond empirical simulation-based validation.}}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:verify_tau_result}{{10}{13}{Result of the Simulink Design Verifier \\ This figure shows the result of a formal property verification performed on the torque constraint model. The verification confirms that the specified safety property is satisfied for all analyzed execution paths. This analysis provides formal guarantees on control torque limits beyond empirical simulation-based validation}{figure.caption.12}{}}
\newlabel{fig:verify_tau_result@cref}{{[figure][10][]10}{[1][13][]13}{}{}{}}
