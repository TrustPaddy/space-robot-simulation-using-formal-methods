\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Seed-level comparison of the successful runs of the default agents with those of TRPO. Each cell gives the median difference $\Delta \tilde  {x}$ (agent minus TRPO) with the Holm-corrected significance of a two-sided Mann--Whitney $U$ test as superscript (${}^{***}p<0.001$, ${}^{**}p<0.01$, ${}^{*}p<0.05$, ${}^{\mathrm  {n.s.}}p\geq 0.05$). For $K_1$, a negative difference means a lower return than TRPO. For the other KPIs, a positive difference means a larger error, jerk, angular velocity, or energy than TRPO. The Holm correction covers the three tested agents for each KPI. PPO and PG are not tested because they have fewer than four successful runs.}}{16}{table.caption.21}\protected@file@percent }
\newlabel{tab:significance}{{9}{16}{Seed-level comparison of the successful runs of the default agents with those of TRPO. Each cell gives the median difference $\Delta \tilde {x}$ (agent minus TRPO) with the Holm-corrected significance of a two-sided Mann--Whitney $U$ test as superscript (${}^{***}p<0.001$, ${}^{**}p<0.01$, ${}^{*}p<0.05$, ${}^{\mathrm {n.s.}}p\geq 0.05$). For $K_1$, a negative difference means a lower return than TRPO. For the other KPIs, a positive difference means a larger error, jerk, angular velocity, or energy than TRPO. The Holm correction covers the three tested agents for each KPI. PPO and PG are not tested because they have fewer than four successful runs}{table.caption.21}{}}
\newlabel{tab:significance@cref}{{[table][9][]9}{[1][15][]16}{}{}{}}
