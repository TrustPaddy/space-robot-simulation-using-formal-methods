\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Overview of the Simulink model \texttt  {SpaceRobot.slx}. The closed-loop model of the free-floating space robot integrates the robot dynamics, reference generation, observation assembly, reward computation, and an RL agent block that outputs joint torques. The same model is used for all six algorithms. The reward and termination logic evaluate end-effector tracking, base motion, and control effort. Two further blocks add the observation noise and the external joint torque of the stress tests. Both are zero in the nominal case.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:spacerobot_slx}{{3}{5}{Overview of the Simulink model \texttt {SpaceRobot.slx}. The closed-loop model of the free-floating space robot integrates the robot dynamics, reference generation, observation assembly, reward computation, and an RL agent block that outputs joint torques. The same model is used for all six algorithms. The reward and termination logic evaluate end-effector tracking, base motion, and control effort. Two further blocks add the observation noise and the external joint torque of the stress tests. Both are zero in the nominal case}{figure.caption.4}{}}
\newlabel{fig:spacerobot_slx@cref}{{[figure][3][]3}{[1][4][]5}{}{}{}}
