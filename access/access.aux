\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Verification model for Simulink Design Verifier (\texttt  {verify\_tau.slx}). The torque command $\tau $ is an unconstrained input and passes through a saturation block with the limits $\pm \tau _{\max }$. A relational operator compares the absolute saturated torques with $\tau _{\max } = 2\,\mathrm  {N\,m}$, and a proof objective (P) requires this comparison to be true.}}{14}{figure.caption.14}\protected@file@percent }
\newlabel{fig:verify_tau}{{10}{14}{Verification model for Simulink Design Verifier (\texttt {verify\_tau.slx}). The torque command $\tau $ is an unconstrained input and passes through a saturation block with the limits $\pm \tau _{\max }$. A relational operator compares the absolute saturated torques with $\tau _{\max } = 2\,\mathrm {N\,m}$, and a proof objective (P) requires this comparison to be true}{figure.caption.14}{}}
\newlabel{fig:verify_tau@cref}{{[figure][10][]10}{[1][12][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Result of Simulink Design Verifier for the torque-bound property. The proof objective of \cref  {fig:verify_tau} is valid for any value of the input $\tau $, and no counterexample was found. The result covers only the saturation of the actuation path, not the policy network, the plant, or other properties.}}{14}{figure.caption.15}\protected@file@percent }
\newlabel{fig:verify_tau_result}{{11}{14}{Result of Simulink Design Verifier for the torque-bound property. The proof objective of \cref {fig:verify_tau} is valid for any value of the input $\tau $, and no counterexample was found. The result covers only the saturation of the actuation path, not the policy network, the plant, or other properties}{figure.caption.15}{}}
\newlabel{fig:verify_tau_result@cref}{{[figure][11][]11}{[1][13][]14}{}{}{}}
