\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Overview of the Reference Subsystem in the Simulink Model \texttt  {SpaceRobot.slx}  This figure shows the computation of end-effector position and velocity tracking errors with respect to the reference trajectory. The measured end-effector states are compared to the reference signals to generate position and velocity error vectors used for observation and reward calculation. In addition, the base linear and angular velocities are extracted to capture base motion induced by manipulator actuation.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:spacerobot_slx_reference}{{5}{9}{Overview of the Reference Subsystem in the Simulink Model \texttt {SpaceRobot.slx}\\ This figure shows the computation of end-effector position and velocity tracking errors with respect to the reference trajectory. The measured end-effector states are compared to the reference signals to generate position and velocity error vectors used for observation and reward calculation. In addition, the base linear and angular velocities are extracted to capture base motion induced by manipulator actuation}{figure.caption.7}{}}
\newlabel{fig:spacerobot_slx_reference@cref}{{[figure][5][]5}{[1][8][]9}{}{}{}}
